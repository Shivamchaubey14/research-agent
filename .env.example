# Copy to .env and fill in. Never commit your real .env.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1

# --- MySQL ---
MYSQL_DATABASE=research
MYSQL_ROOT_PASSWORD=root@123
# DATABASE_URL is consumed by Django/worker. Note: '@' in the password is
# URL-encoded as %40. Inside docker-compose the host is the `mysql` service;
# for running the API on the host against a local MySQL use 127.0.0.1.
DATABASE_URL=mysql://root:root%40123@127.0.0.1:3306/research

# --- Infra (defaults match docker-compose service names) ---
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
QDRANT_URL=http://qdrant:6333

# --- Optional: web search provider for the agent (Phase 2) ---
# TAVILY_API_KEY=
